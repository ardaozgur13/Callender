# Bu dosyayı .env adıyla kopyala ve değerleri doldur. .env asla commit'lenmez.

# Uzun, rastgele bir değer. Üretmek için:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=buraya-uzun-rastgele-bir-deger

# Yerelde True, canlıda (Vercel) False
DEBUG=True

# Supabase > Project Settings > Database > Connection pooling (Transaction mode, port 6543)
DATABASE_URL=postgresql://postgres.PROJE_REF:SIFRE@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require

# Virgülle ayrılmış ek alan adları (localhost, 127.0.0.1 ve .vercel.app zaten ekli)
ALLOWED_HOSTS=
# Virgülle ayrılmış, şemalı tam adresler (örn. https://callender.vercel.app)
CSRF_TRUSTED_ORIGINS=
